{
  "name": "alivo-os",
  "version": "1.0.0",
  "description": "**AI Business Operating System**",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "tsc --project tsconfig.json && npm run build:electron-runtime",
    "build:electron-runtime": "node scripts/build-electron-runtime.mjs",
    "verify:package-sources": "node scripts/verify-public-package-sources.mjs",
    "test:pinterest:dom": "node --experimental-transform-types --test tests/unit/PinterestDomIntegration.test.ts",
    "test:pinterest:electron-windows": "node --experimental-transform-types --test tests/integration/PinterestElectronWindows.test.ts",
    "test:pinterest:local-config": "node --experimental-transform-types --test tests/unit/PinterestLocalVault.test.ts tests/unit/PinterestLocalConfigBoundary.test.ts",
    "test": "node --experimental-transform-types --test tests/unit/*.test.ts",
    "desktop:smoke": "node --check ui/shell.js && node --check electron/main.cjs",
    "pack": "npm run build && electron-builder --dir",
    "package:portable:windows": "node scripts/build-portable-windows.mjs",
    "package:verify": "npm run verify:package-sources && npm run test:pinterest:dom && npm run test:pinterest:local-config && node --experimental-transform-types --test tests/unit/PortableWindowsPackage.test.ts && node scripts/verify-windows-packaging.mjs",
    "package:win": "npm run build && npm run package:verify && electron-builder --win nsis --x64 --config electron-builder.yml",
    "dist:windows": "npm run build && electron-builder --win nsis --x64",
    "package:windows": "npm run build && electron-builder --win nsis --x64",
    "release:archive": "python3 scripts/create_release_archive.py"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "43.4.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "yazl": "3.3.1"
  },
  "build": {
    "appId": "com.alivo.os",
    "productName": "ALIVO OS",
    "artifactName": "ALIVO-OS-v${version}-Setup.${ext}",
    "asar": true,
    "directories": {
      "buildResources": "build-resources",
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "ui/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.env*",
      "!**/pinterest-local-config.enc",
      "!**/node_modules/.cache/**/*"
    ],
    "win": {
      "executableName": "ALIVO-OS",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ALIVO OS",
      "uninstallDisplayName": "ALIVO OS",
      "deleteAppDataOnUninstall": false
    }
  }
}
