{
  "name": "alivo-os",
  "version": "1.0.0",
  "description": "**AI Business Operating System**",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "tsc --project tsconfig.json",
    "test": "node --experimental-transform-types --test tests/unit/*.test.ts",
    "desktop:smoke": "node --check ui/shell.js && node --check electron/main.cjs",
    "pack": "electron-builder --dir",
 codex/modify-gitignore-for-windows-binaries
    "package:verify": "node scripts/verify-windows-packaging.mjs",
    "package:win": "npm run package:verify && electron-builder --win nsis --x64 --config electron-builder.yml"
codex/ensure-windows-10-and-11-compatibility
    "dist:windows": "electron-builder --win nsis --x64"
codex/create-certified-full-program-archive
    "package:windows": "electron-builder --win nsis --x64",
    "release:archive": "python3 scripts/create_release_archive.py"
    "package:windows": "electron-builder --win nsis --x64",
    "package:verify": "node scripts/verify-packaging.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2"
 codex/modify-gitignore-for-windows-binaries
  },
  "build": {
  "appId": "com.alivo.os",
  "productName": "ALIVO OS",
  "artifactName": "ALIVO-OS-v${version}-Setup.${ext}",
  "asar": true,
  "directories": {
    "buildResources": "build-resources",
    "output": "dist"
  },
  "files": [
    "electron/**/*",
    "ui/**/*",
    "package.json",
    "!**/*.map",
    "!**/node_modules/.cache/**/*"
  ],
  "win": {
    "executableName": "ALIVO-OS",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "ALIVO OS",
    "uninstallDisplayName": "ALIVO OS",
    "deleteAppDataOnUninstall": false
  }
}
    }
  }
}
