{
  "name": "alivo-os",
  "version": "1.0.0",
  "description": "**AI Business Operating System**",
  "private": true,
  "main": "electron/main.cjs",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "electron .",
    "build": "tsc --project tsconfig.json",
    "test": "node --experimental-transform-types --test tests/unit/*.test.ts",
    "desktop:smoke": "node --check ui/shell.js && node --check electron/main.cjs",
    "pack": "electron-builder --dir",
    "package:verify": "node scripts/verify-windows-packaging.mjs",
    "package:win": "npm run package:verify && electron-builder --win nsis --x64 --config electron-builder.yml"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2"
  }
}
